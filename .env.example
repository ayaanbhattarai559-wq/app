# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=stockflow
DB_PASSWORD=change-me
DB_NAME=stockflow

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# If true, tables are created automatically on startup (fine for dev; use Alembic in prod)
AUTO_CREATE_TABLES=true

# If true, seeds the mock data from the frontend into an empty database on startup
SEED_ON_STARTUP=true
